{
  "name": "@termflow/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TermFlow API 서버(NestJS, Express 어댑터)",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "node ../../scripts/run-vitest.mjs run --config vitest.db.config.ts --passWithNoTests",
    "db:migrate": "node -e \"console.error('db:migrate — 단계 2(T2.x)에서 구현 예정'); process.exit(1)\"",
    "db:pull": "node -e \"console.error('db:pull(drizzle-kit pull) — 단계 2(T2.x)에서 구현 예정'); process.exit(1)\"",
    "migrate:seed": "node -e \"console.error('migrate:seed — 단계 3(T3.x)에서 구현 예정'); process.exit(1)\""
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@termflow/shared": "workspace:*",
    "bcrypt": "6.0.0",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "drizzle-orm": "0.45.3",
    "express-session": "1.19.0",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.3.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
