{
  "name": "@termflow/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TermFlow API 서버(NestJS, Express 어댑터)",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts --passWithNoTests",
    "db:migrate": "node -e \"console.error('db:migrate — 단계 2(T2.x)에서 구현 예정'); process.exit(1)\"",
    "db:pull": "node -e \"console.error('db:pull(drizzle-kit pull) — 단계 2(T2.x)에서 구현 예정'); process.exit(1)\"",
    "migrate:seed": "node -e \"console.error('migrate:seed — 단계 3(T3.x)에서 구현 예정'); process.exit(1)\""
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@termflow/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
