{
  "name": "termflow",
  "version": "1.3.5",
  "private": true,
  "type": "module",
  "description": "TermFlow — 표준 용어 기반 테이블 설계·DDL 생성 서비스",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @termflow/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check . && pnpm check:no-ai",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @termflow/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @termflow/server test:db",
    "db:migrate": "pnpm --filter @termflow/server db:migrate",
    "db:reset": "pnpm --filter @termflow/server db:reset",
    "db:pull": "pnpm --filter @termflow/server db:pull",
    "migrate:seed": "pnpm --filter @termflow/server migrate:seed",
    "check:no-ai": "node scripts/check-no-ai.mjs",
    "e2e": "pnpm --filter @termflow/e2e e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
