# TermFlow 환경 변수(설계서 §2.8, 부록 B.3). 이 파일을 .env로 복사해 값을 채운다(.env는 커밋 금지).
# 주의: 주석은 반드시 별도 줄에 쓴다. `KEY=   # 설명`처럼 값 없이 뒤에 주석을 달면
#       docker compose(env_file)가 "# 설명"을 값으로 읽는다(CR-11a C4).
# 공통
TERMFLOW_DB_URL=postgres://localhost:7341/termflow
TERMFLOW_DB_USER=termflow
TERMFLOW_DB_PASSWORD=
TERMFLOW_ADMIN_LOGIN=admin
TERMFLOW_ADMIN_PASSWORD=
TERMFLOW_SESSION_TIMEOUT=60m
TERMFLOW_UPLOAD_MAX_MB=10
TERMFLOW_DEFAULT_DIALECT=POSTGRESQL
TERMFLOW_LEGACY_DUMP=/seed/dump-gen_table-new.sql
# N안 전용
NODE_ENV=development
PORT=8080
# 32바이트 이상 난수, prod 필수
TERMFLOW_SESSION_SECRET=
DB_POOL_MAX=10
TERMFLOW_ORACLE_COMPAT=19c
TERMFLOW_REPORT_DIR=./migration/report
# 비우면 PostgreSQL만(D2 확정), 예: oracle,mysql
TERMFLOW_TEST_DIALECTS=
# 자동완성 캐시 LRU 상한(5.1)
TERMFLOW_CACHE_MAX_PROJECTS=20
LOG_LEVEL=info
# 컨테이너 실행(docker compose, start.ps1). 운영은 기본값 그대로 둔다.
# 같은 PC에 두 번째 인스턴스를 띄울 때·포트가 겹칠 때만 바꾼다(CR-11a C3). 호스트 포트 기본 app 7340 · db 7341(CR-12 C16)
#COMPOSE_PROJECT_NAME=termflow
#TERMFLOW_DB_CONTAINER=termflow-db
#TERMFLOW_APP_CONTAINER=termflow-app
#TERMFLOW_DB_PORT=7341
#TERMFLOW_APP_PORT=7340
